# Register at https://api.tradera.com/register to get these.
# TRADERA_APP_ID is the NUMERIC App ID (e.g. 6393) — not the GUID.
TRADERA_APP_ID=
# TRADERA_APP_KEY is the GUID App Key (secret) from the developer program.
TRADERA_APP_KEY=
# (The "Public Key" from Tradera is only needed for per-user token login,
#  which this server does not use — leave it out.)

# Optional: default Blocket search scope, as a comma-separated list of region
# (län) names (see the list_blocket_locations tool for valid values). Leave
# unset to search ALL of Sweden. You can always override per-search with the
# `locations` argument. Example for the Växjö / Älmhult area:
#   BLOCKET_LOCATIONS=KRONOBERG,KALMAR,JONKOPING,HALLAND,SKANE
BLOCKET_LOCATIONS=

# Leave 0 to keep Facebook Marketplace search disabled (recommended).
# Only set to 1 if you've implemented src/facebook_client.py yourself and
# accept the Terms-of-Service risk described in that file.
ENABLE_FACEBOOK_SEARCH=0
